{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev server (live preview)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "http://localhost:[0-9]+"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Check (typecheck + lint + test + build)",
      "type": "shell",
      "command": "npm run check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Optimise images",
      "type": "shell",
      "command": "npm run images",
      "problemMatcher": []
    }
  ]
}
